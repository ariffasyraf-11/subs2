{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "ariffasyraf-11/subs2",
  "type": "project",
  "description": "Subscription Tracker & Notification System",
  "keywords": ["laravel", "filament", "subscription", "notifications"],
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "filament/filament": "^5.0",
    "laravel/framework": "^13.0",
    "laravel/tinker": "^2.10"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "laravel/pint": "^1.24",
    "laravel/sail": "^1.50",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.8",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "setup": [
      "composer install",
      "@php -r "file_exists('.env') || copy('.env.example', '.env');"",
      "@php artisan key:generate",
      "@php artisan migrate --graceful --ansi",
      "@php artisan db:seed --ansi"
    ],
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "npx concurrently -c "#93c5fd,#c4b5fd,#fb7185" "php artisan serve" "php artisan queue:listen --tries=1" "php artisan pail --timeout=0""
    ],
    "test": [
      "@php artisan config:clear",
      "@php artisan test"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
